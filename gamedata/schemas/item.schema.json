{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhgioi.local/schema/item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "category",
    "rarity",
    "stack_limit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^item\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "category": {
      "enum": [
        "weapon",
        "armor",
        "material",
        "consumable",
        "cosmetic",
        "housing"
      ]
    },
    "rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ]
    },
    "stack_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999
    }
  }
}