{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhgioi.local/schema/world-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "map_id",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^event\\.world\\.[a-z0-9_]+$"
    },
    "map_id": {
      "type": "string",
      "pattern": "^map\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        }
      }
    }
  }
}