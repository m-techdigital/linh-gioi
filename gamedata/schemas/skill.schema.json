{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linhgioi.local/schema/skill.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "class_id",
    "cooldown_ms",
    "damage",
    "range_m",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^skill\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "class_id": {
      "type": "string",
      "pattern": "^class\\.[a-z0-9_]+$"
    },
    "cooldown_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coefficient"
      ],
      "properties": {
        "coefficient": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "range_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    }
  }
}